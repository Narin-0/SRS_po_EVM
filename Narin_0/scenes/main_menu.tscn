// Создайте сцену вручную в редакторе или используйте этот скрипт:

// filepath: /home/narin-0/Documents/GitHub/SRS_po_EVM/Narin_0/ui/main_menu.gd
extends Control

@onready var host_btn = $VBoxContainer/HostButton
@onready var join_btn = $VBoxContainer/JoinButton
@onready var ip_input = $VBoxContainer/IPInput
@onready var port_input = $VBoxContainer/PortInput
@onready var status_label = $VBoxContainer/StatusLabel

var network_manager: Node


func _ready() -> void:
    network_manager = get_tree().root.get_node("NetworkManager")
    
    if not network_manager:
        push_error("❌ NetworkManager не найден в Autoload!")
        status_label.text = "❌ Ошибка: NetworkManager не загружен"
        return
    
    print("✅ NetworkManager найден")
    
    host_btn.pressed.connect(_on_host_pressed)
    join_btn.pressed.connect(_on_join_pressed)
    
    network_manager.player_connected.connect(_on_player_connected)
    network_manager.connection_failed.connect(_on_connection_failed)
    
    status_label.text = "⏳ Ожидание подключения..."


func _on_host_pressed() -> void:
    print("🖥️ Создание сервера...")
    network_manager.host_game()
    host_btn.disabled = true
    join_btn.disabled = true
    ip_input.editable = false
    status_label.text = "🖥️ Вы хост сервера (ожидание игроков...)"


func _on_join_pressed() -> void:
    var ip = ip_input.text
    var port = port_input.text
    
    if ip.is_empty():
        status_label.text = "⚠️ Введите IP адрес"
        return
    
    print("🔄 Подключение к %s:%s..." % [ip, port])
    network_manager.join_game(ip, int(port) if port else 9999)
    join_btn.disabled = true
    host_btn.disabled = true
    status_label.text = "🔄 Подключение к %s..." % ip


func _on_player_connected(peer_id: int) -> void:
    print("✅ Игрок подключен: %d" % peer_id)
    status_label.text = "✅ Игрок %d подключен!" % peer_id
    
    await get_tree().create_timer(2.0).timeout
    print("📍 Загрузка уровня...")
    get_tree().change_scene_to_file("res://scenes/multiplayer_level.tscn")


func _on_connection_failed() -> void:
    print("❌ Ошибка подключения")
    status_label.text = "❌ Ошибка подключения"
    host_btn.disabled = false
    join_btn.disabled = false
    ip_input.editable = true